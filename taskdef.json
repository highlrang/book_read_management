{
  "family": "book_read_management_api",
  "networkMode": "bridge",
  "executionRoleArn": "arn:aws:iam::642078921209:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::642078921209:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "book_read_management_api",
      "image": "<ECR_URI>@<DIGEST>",
      "portMappings": [{ "containerPort": 8080, "hostPort": 0 }],
      "environment": [
        { "name": "DB_USER", "value": "admin" },
        { "name": "DB_PASSWORD", "value": "admin1234" },
        { "name": "MYNAME", "value": "정혜우(자동배포)" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/book_read_management_api",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "cpu": 1024,
      "memory": 3072
    }
  ],
  "requiresCompatibilities": ["EC2"]
}